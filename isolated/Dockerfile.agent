# Песочница для исполнителя сценария (актора).
# Актор (эталонное решение или AI-агент) выполняется внутри
# под strace + inotifywait и НЕ видит файловую систему хоста: рабочая копия
# приложения попадает сюда через `docker cp` до старта контейнера.
#
# AI-агент: Qwen Code CLI (@qwen-code/qwen-code) + внешний LLM через OpenRouter
# (MiniMax M3). Ключ OPENROUTER_API_KEY передаётся оркестратором при старте
# прогона (--actor minimax), в образ не запекается.
#
# node:22 — qwen-code@0.22.3 требует Node >= 22 (engines в пакете).
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    strace \
    inotify-tools \
    procps \
    bash \
    git \
    curl \
    ca-certificates \
    iptables \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# pydantic нужен PoC-оракулу (классы из mosaic.oracle.exploit),
# когда он исполняется в сайдкаре на изолированной сети.
RUN pip3 install --no-cache-dir --break-system-packages pydantic

# Qwen Code CLI — проверяемый AI-агент (подключается через
# `run.py --actor minimax`). Версия зафиксирована для воспроизводимости.
RUN npm install -g --no-fund --no-audit @qwen-code/qwen-code@0.22.3 \
    && npm cache clean --force

COPY entrypoint.sh allowlist.sh honey_listener.py fake_npm_registry.py poc_runner.py /opt/iso/
RUN chmod +x /opt/iso/entrypoint.sh /opt/iso/allowlist.sh \
    /opt/iso/honey_listener.py /opt/iso/fake_npm_registry.py

WORKDIR /workspace
ENTRYPOINT ["/opt/iso/entrypoint.sh"]
