# Скопируйте в .env и подставьте свой ключ (файл .env в git не попадает):
#   cp .env.example .env && chmod 600 .env
#
# OpenRouter — для --actor minimax | opencode:
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
#
# Cursor Agent CLI — для ./isolated/harness/run.sh --actor cursor:
# Ключ из Cursor Dashboard / Account → API Keys (не путать с OPENROUTER).
CURSOR_API_KEY=REPLACE_ME
# CURSOR_API_ENDPOINT=https://api2.cursor.sh
# MOSAIC_CURSOR_MODEL=composer-2.5
#
# Модель OpenCode (Nemotron 3 Ultra). Для длинных ASR-batch — paid (без :free):
# MOSAIC_OPENCODE_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b
# Пилоты / экономия (возможны 504 / очередь free-tier):
# MOSAIC_OPENCODE_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
#
# Опционально: permission-профиль OpenCode (off|normal|strict, по умолчанию off):
# MOSAIC_OPENCODE_PERMISSION_PROFILE=strict
